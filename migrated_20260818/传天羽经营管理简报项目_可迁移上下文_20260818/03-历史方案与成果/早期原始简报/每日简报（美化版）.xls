<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>简报</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]-->
<style>
  /* ===== 全局 ===== */
  body { 
    font-family: "Microsoft YaHei", "Segoe UI", Arial, sans-serif; 
    margin: 0; 
    padding: 20px; 
    background: #f4f7fc; 
  }
  table { 
    border-collapse: collapse; 
    width: 100%; 
    font-size: 12px; 
    background: #ffffff; 
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    border-radius: 8px;
  }
  th, td { 
    border: 1px solid #e2e8f0; 
    padding: 8px 10px; 
    text-align: center; 
    vertical-align: middle; 
  }
  /* ===== 标题区 ===== */
  .main-title {
    background: #0f172a;
    color: #ffffff;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 2px;
    padding: 16px 20px;
    text-align: left;
    border-radius: 8px 8px 0 0;
  }
  .main-title span { color: #60a5fa; }
  .meta-bar {
    background: #f8fafc;
    color: #334155;
    font-size: 13px;
    font-weight: 500;
    border-bottom: 2px solid #e2e8f0;
  }
  .meta-bar td { padding: 10px 16px; }
  /* ===== 摘要卡片（置顶） ===== */
  .summary-section { background: #ffffff; }
  .summary-card {
    padding: 12px 14px;
    font-size: 13px;
    font-weight: 600;
    text-align: left;
    border-left: 6px solid;
    border-radius: 4px;
    margin: 4px 0;
  }
  .card-green { background: #f0fdf4; border-left-color: #16a34a; color: #14532d; }
  .card-yellow { background: #fffbeb; border-left-color: #f59e0b; color: #78350f; }
  .card-red   { background: #fef2f2; border-left-color: #ef4444; color: #7f1d1d; }
  /* ===== 板块标题 ===== */
  .section-header {
    background: #1e293b;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    text-align: left;
    padding: 10px 18px;
    letter-spacing: 1px;
  }
  .sub-header {
    background: #eef2ff;
    color: #1e3a8a;
    font-size: 14px;
    font-weight: 700;
    text-align: left;
    padding: 8px 16px;
    border-bottom: 2px solid #c7d2fe;
  }
  .group-title {
    background: #f1f5f9;
    font-weight: 700;
    color: #0f172a;
    text-align: left;
    padding: 6px 14px;
    font-size: 13px;
    border-left: 4px solid #3b82f6;
  }
  /* ===== 表格行样式 ===== */
  .th-light {
    background: #f8fafc;
    font-weight: 700;
    color: #1e293b;
    font-size: 12px;
  }
  .total-row {
    background: #f1f5f9;
    font-weight: 700;
    color: #0f172a;
    border-top: 2px solid #94a3b8;
  }
  .even-row { background: #fafcff; }
  .odd-row { background: #ffffff; }
  .small-note {
    background: #fefce8;
    color: #713f12;
    font-size: 11px;
    text-align: left;
    padding: 6px 14px;
    border-left: 4px solid #eab308;
  }
  /* ===== 状态标识 ===== */
  .status-ok { color: #16a34a; font-weight: 700; background: #dcfce7; padding: 2px 8px; border-radius: 12px; }
  .status-warn { color: #ea580c; font-weight: 700; background: #ffedd5; padding: 2px 8px; border-radius: 12px; }
  .status-danger { color: #dc2626; font-weight: 700; background: #fee2e2; padding: 2px 8px; border-radius: 12px; }
  .arrow-up { color: #16a34a; font-weight: 700; }
  .arrow-down { color: #dc2626; font-weight: 700; }
  .badge-blue { background: #dbeafe; color: #1e40af; padding: 2px 10px; border-radius: 12px; font-weight: 600; }
  .badge-gray { background: #e2e8f0; color: #475569; padding: 2px 10px; border-radius: 12px; }
  /* ===== 决策区 ===== */
  .decision-area {
    background: #fffbeb;
    border-left: 6px solid #f59e0b;
    text-align: left;
    padding: 12px 18px;
    font-weight: 500;
    color: #78350f;
  }
  /* ===== 排版微调 ===== */
  .text-left { text-align: left; }
  .text-right { text-align: right; }
  .indent { padding-left: 24px; }
  .gap-row { background: #f4f7fc; height: 6px; border: none; }
  .gap-row td { border: none; }
</style>
</head>
