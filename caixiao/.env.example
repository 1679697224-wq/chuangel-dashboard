# 复制到仓库外的安全配置系统，或在启动进程中注入。不要提交 .env。
CAIXIAO_HOST=127.0.0.1
CAIXIAO_PORT=8010
CAIXIAO_DB_PATH=caixiao/runtime/caixiao.sqlite3
CAIXIAO_ALLOWED_ORIGINS=http://127.0.0.1:8010,http://localhost:8010

# 演示开关。true 只使用纯 Mock Demo Adapter；false 只读取正式链路，缺失即“待接入”。
# 两种模式不会自动回退或静默混用。
DEMO_MODE=false

# 必填：至少 32 个随机字符，只能由安全配置系统或本地进程环境注入。
CAIXIAO_TOKEN_SECRET=

# 首次本地初始化账号；创建后应从环境中移除明文密码。
CAIXIAO_BOOTSTRAP_USER=
CAIXIAO_BOOTSTRAP_PASSWORD=

# 吉客云真实接口参数：当前均待 WorkBuddy 在实际环境联调后填写。
# 未配置时适配器保持 DISABLED，不会伪造返回结果。
JKY_BASE_URL=
JKY_APP_KEY=
JKY_APP_SECRET=
JKY_ACCESS_TOKEN=
JKY_SALES_ENDPOINT=
JKY_INVENTORY_ENDPOINT=
JKY_PURCHASE_ENDPOINT=
JKY_TRANSFER_ENDPOINT=

# 仅限 Sandbox 的既有快照目录。不要指向正式 KPI 数据目录。
CAIXIAO_SANDBOX_SNAPSHOT_DIR=
